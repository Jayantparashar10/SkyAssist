# Copy to backend/.env.local for local development.
# backend/.env.local is gitignored — never commit real secrets.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Neon pooled connection string. For local dev without Neon, point this at
# a local Postgres and run `psql $DATABASE_URL -f backend/schema.sql` once.
DATABASE_URL=postgresql://user:password@host/dbname

# Comma-separated browser origins allowed to call this API cross-origin.
# In production this should be exactly the deployed frontend's URL —
# nothing else needs it, since the frontend proxies /api/* server-side.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Fixed simulated clock (A-14: the data pack gives no time of day) — leave
# as-is for the three scenarios.
SIM_NOW=2026-09-23T10:00:00+05:30

SUPERVISOR_PASSCODE=
